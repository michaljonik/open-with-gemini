{
  "manifest_version": 3,
  "name": "Open with Gemini",
  "version": "1.0.0",
  "description": "Right-click any link, or click the icon for the current page, to open it in Gemini with your own custom prompt.",
  "permissions": ["contextMenus", "activeTab", "storage"],
  "host_permissions": ["https://gemini.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/app*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open this page with Gemini"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
